// --- CORE FINANCIAL QUIRIES ---

SELECT 
    products.product_category,
    COUNT(sales.sales_id) AS total_sales
FROM products
JOIN sales ON products.product_id = sales.product_id
WHERE 1=1
  [[AND {{date_filter}}]]
  [[AND {{product_category}}]]
GROUP BY products.product_category
ORDER BY 1;
------------------------------------------------------
