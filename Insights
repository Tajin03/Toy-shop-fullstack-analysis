SELECT 
    store.store_name ,
	store.store_city,
   round( SUM(products.product_price * sales.unit_sold)) AS total_revenue
FROM sales
LEFT JOIN products ON products.product_id = sales.product_id
LEFT JOIN store ON store.store_id = sales.store_id 
GROUP BY 1,2
ORDER BY total_revenue 
-----------------------------------------------------------------------------------------------------------------

select products.product_name,
date_trunc('month', sales.date) as month_start,
round(sum((products.product_price-products.product_cost)* sales.unit_sold))as profit_margin
from products
left join sales on sales.product_id=products.product_id
where 1=1
[[and  {{date_filter}}]]
[[ and {{product_name}}]]
group by 1,2
order by 1 
-------------------------------------------------------------------------------------------------------------
SELECT 
    DATE_TRUNC('week', sales.calender_date) AS week_start,
    SUM((products.product_price - products.product_cost) * sales.unit_sold) AS weekly_profit,
    {{target}}::numeric AS weekly_target, 
    ((SUM((products.product_price - products.product_cost) * sales.unit_sold) - {{target}}::numeric)) AS variance
FROM sales
JOIN products ON sales.product_id = products.product_id
WHERE 1=1
  [[AND {{date_filter}}]]
GROUP BY 1, 3
ORDER BY 1;




