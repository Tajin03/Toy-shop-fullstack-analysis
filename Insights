order by 1
---------------------------------------------------------
WITH most_profit AS (
    SELECT 
        ROUND(SUM((products.product_price - products.product_cost) * sales.unit_sold)::numeric, 2) AS profit
    FROM sales
    JOIN products ON sales.product_id = products.product_id
    JOIN store ON sales.store_id = store.store_id
    GROUP BY store.store_id
    ORDER BY profit DESC
    LIMIT 1
),
least_profit AS (
    SELECT 
        ROUND(SUM((products.product_price - products.product_cost) * sales.unit_sold)::numeric, 2) AS profit
    FROM sales
    JOIN products ON sales.product_id = products.product_id
    JOIN store ON sales.store_id = store.store_id
    GROUP BY store.store_id
    ORDER BY profit ASC
    LIMIT 1
)
SELECT 
  
    ROUND(
        (((most_profit.profit - least_profit.profit) / NULLIF(ABS(least_profit.profit), 0)) * 100)::numeric, 
        2
    ) AS profit_percentage_difference
FROM most_profit, least_profit;
